    given-names: Arhan
    affiliation: Quantavane
    email: arhan@quantavane.com
license: CC-BY-4.0
url: "https://quantavane.com"
repository-code: "https://github.com/arhancanli/quantavane-davenport-c6"
keywords:
  - Davenport constant
  - zero-sum theory
  - van Emde Boas-Kruyswijk conjecture
  - finite abelian groups
